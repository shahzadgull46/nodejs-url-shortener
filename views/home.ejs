<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>home page</title>
</head>

<body>
  <h1>URL Shortner</h1>
  <div>
    <form action="/url" method="POST">
      <label for="url">Enter a Long URL</label>
      <input id="url" name="url" type="url" placeholder="https://example.com">
      <button>Generate</button>
    </form>

    <% if (locals.id) { %>

    <h3>URL is generated : </h3>
    <p><%= shortUrl %></p>

    <% } %>

    <% if (locals.urls) { %>
    <table>
      <thead>
        <tr>
          <th>S. No</th>
          <th>Short Id</th>
          <th>Redirect URL</th>
          <th>Clicks</th>
        </tr>
      </thead>
      <tbody>

        <% urls.forEach((url,index) => { %>
        <tr>
          <td> <%= index + 1 %></td>
          <td><%= url.shortId %></td>
          <td><%= url.redirectURL %></td>
          <td><%= url.visitHistory.length %></td>
        </tr>

        <% }) %>
      </tbody>

    </table>
    <% } %>
  </div>
  <div>
  </div>

</body>

</html>